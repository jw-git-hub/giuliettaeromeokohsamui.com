# Демо-сборка: npm run build:demo. Закрыта от поиска (noindex и Disallow).
PUBLIC_DEMO=true
# Адрес и папка, где живёт демо: GitHub Pages этого репозитория. Без SITE_URL демо не соберётся.
SITE_URL=https://jw-git-hub.github.io
BASE_PATH=/giuliettaeromeokohsamui.com/
# Языки-черновики в демо. Русский John разрешил; итальянский и тайский — только после его «да».
PREVIEW_LOCALES=ru
