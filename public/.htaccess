# Giulietta e Romeo — настройки Apache для обычного хостинга.
# Каждая настройка обёрнута проверкой модуля: если модуля на хостинге нет, сайт продолжит работать.

AddDefaultCharset UTF-8

# Типы файлов, которых может не быть в старых настройках сервера.
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
</IfModule>

# Сжатие текстовых файлов. Brotli жмёт сильнее gzip; если его модуля на хостинге нет, работает gzip ниже.
<IfModule mod_brotli.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json application/xml text/xml text/plain image/svg+xml
  </IfModule>
</IfModule>

<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml text/xml text/plain image/svg+xml
  </IfModule>
</IfModule>

<IfModule mod_headers.c>
  # Страницы и служебные файлы всегда перепроверяются: правки видны сразу.
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Картинка для мессенджеров и иконки: имя постоянное, кэш на неделю.
  <FilesMatch "^(og\.jpg|favicon\.svg|apple-touch-icon\.png)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Файлы с хэшем в имени (стили, шрифты, фото из папки _astro) не меняются никогда: кэш на год.
  # Пример имён: index.DU3ZSt7q.css, hero-lantern.B6mjQZvF_Z1OEoxy.avif
  <FilesMatch "\.[A-Za-z0-9_-]{8}(_[A-Za-z0-9]+)?\.(css|js|woff2|avif|webp|jpg|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
</IfModule>
