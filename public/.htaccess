# Giulietta e Romeo — настройки Apache для обычного хостинга.

AddDefaultCharset UTF-8

# Типы файлов, которых может не быть в старых настройках сервера.
AddType image/avif .avif
AddType image/webp .webp
AddType font/woff2 .woff2
AddType image/svg+xml .svg

# Сжатие текстовых файлов.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml text/xml text/plain image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Страницы и служебные файлы всегда перепроверяются: правки видны сразу.
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Картинка для мессенджеров и иконки: имя постоянное, кэш на неделю.
  <FilesMatch "^(og\.jpg|favicon\.svg|apple-touch-icon\.png)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Файлы с хэшем в имени (стили, шрифты, фото) не меняются никогда: кэш на год.
  <If "%{REQUEST_URI} =~ m#/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  Header set X-Content-Type-Options "nosniff"
</IfModule>
