---
import { EXTERNAL_LINK } from '@/config/links';
import { WHATSAPP_URL } from '@/config/restaurant';
import { buildQrCode } from '@/data/qr-code';
import type { Dictionary } from '@/i18n';
import './WhatsAppQr.css';

// QR нужен тем, кто сидит за компьютером: на телефоне скрыт.
// Код рисуется из ссылки на WhatsApp (src/data/qr-code.ts): тёмные клетки на кремовой карточке.
interface Props {
  t: Dictionary;
}

const { qr } = Astro.props.t.reservations;
const code = buildQrCode(WHATSAPP_URL);
---

<aside class="whatsapp-qr" aria-label={qr.ariaLabel}>
  <a
    class="whatsapp-qr__link"
    href={WHATSAPP_URL}
    aria-label={qr.linkLabel}
    data-goal="whatsapp-qr"
    {...EXTERNAL_LINK}
  >
    <svg
      class="whatsapp-qr__image"
      viewBox={`0 0 ${code.size} ${code.size}`}
      role="img"
      aria-label={qr.alt}
      shape-rendering="crispEdges"
    >
      <path d={code.path}></path>
    </svg>
  </a>
  <div>
    <h3 class="whatsapp-qr__title">{qr.title}</h3>
    <p class="whatsapp-qr__text">{qr.text}</p>
  </div>
</aside>
