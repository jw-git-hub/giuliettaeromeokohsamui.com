---
import type { MenuItem } from '@/data/menu';
import './MenuItem.css';

// Позиция меню: название, маленькая золотая «V», цена на той же линии; ниже — описание.
// Расшифровки «V» и знака валюты на странице нет: их нет в исходном меню (вопрос к владелице).
interface Props {
  item: MenuItem;
}

const V_MARK = 'V';

const { item } = Astro.props;
---

<li class="menu-item">
  <div class="menu-item__head">
    <p class="menu-item__name">
      {item.name}{item.hasVMark && <span class="menu-item__v">{V_MARK}</span>}
    </p>
    <p class="menu-item__price">{item.price}</p>
  </div>
  <p class="menu-item__description">{item.description}</p>
</li>
