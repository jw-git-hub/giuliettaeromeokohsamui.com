---
import { IS_DEMO } from '@/config/env';
import { THEME_COLOR } from '@/config/site.mjs';
import { BUILD_LOCALES, getLocaleInfo, type Dictionary, type LocaleCode } from '@/i18n';
import shared from '@/i18n/shared.json';
import { alternateLinks, assetUrl, canonicalUrl } from '@/i18n/urls';

// Заголовок, описание, канонический адрес, языковые версии, карточка для мессенджеров, иконка.
interface Props {
  locale: LocaleCode;
  t: Dictionary;
  /** Полный адрес картинки 1200×630. */
  imageUrl: string;
}

const OG_IMAGE_WIDTH = 1200;
const OG_IMAGE_HEIGHT = 630;

const { locale, t, imageUrl } = Astro.props;
const { first, conjunction, last } = shared.name;
const siteName = `${first} ${conjunction} ${last}`;
const otherLocales = BUILD_LOCALES.filter((code) => code !== locale);
---

<title>{t.meta.title}</title>
<meta name="description" content={t.meta.description} />
<link rel="canonical" href={canonicalUrl(locale)} />
{alternateLinks().map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
{IS_DEMO && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={t.meta.title} />
<meta property="og:description" content={t.meta.description} />
<meta property="og:url" content={canonicalUrl(locale)} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
<meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
<meta property="og:image:alt" content={siteName} />
<meta property="og:locale" content={getLocaleInfo(locale).ogLocale} />
{otherLocales.map((code) => <meta property="og:locale:alternate" content={getLocaleInfo(code).ogLocale} />)}
<meta name="twitter:card" content="summary_large_image" />

<link rel="icon" href={assetUrl('favicon.svg')} type="image/svg+xml" />
<link rel="apple-touch-icon" href={assetUrl('apple-touch-icon.png')} />
<meta name="theme-color" content={THEME_COLOR} />
