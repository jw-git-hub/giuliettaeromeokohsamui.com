---
import Icon from '@/components/ui/Icon/Icon.astro';
import './Lightbox.css';

// Увеличенные фото на нативном <dialog>: лента из всех фото, которая листается пальцем
// (прокрутка с остановкой на каждом фото), точки под фото показывают, какое открыто.
// На планшете и компьютере есть ещё стрелки. Открывает и листает src/scripts/lightbox.ts;
// без скриптов плитка галереи — обычная ссылка на большое фото.
// Кнопки «назад» и «вперёд» получают подпись соседнего фото — новых фраз не нужно.
export interface LightboxPhoto {
  src: string;
  width: number;
  height: number;
  caption: string;
}

interface Props {
  /** Название окна для экранных читалок — надпись секции. */
  label: string;
  closeLabel: string;
  photos: LightboxPhoto[];
}

const { label, closeLabel, photos } = Astro.props;
---

<dialog class="lightbox" aria-label={label} data-lightbox>
  <button class="lightbox__button lightbox__button--close" type="button" aria-label={closeLabel} data-lightbox-close>
    <Icon name="close" />
  </button>
  <button class="lightbox__button lightbox__button--previous" type="button" data-lightbox-previous>
    <Icon name="chevron" />
  </button>
  <ul class="lightbox__track" data-lightbox-track>
    {
      photos.map((photo) => (
        <li class="lightbox__slide">
          <figure class="lightbox__figure">
            <img
              class="lightbox__image"
              src={photo.src}
              width={photo.width}
              height={photo.height}
              alt={photo.caption}
              loading="lazy"
              decoding="async"
            />
            <figcaption class="lightbox__caption">{photo.caption}</figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
  <button class="lightbox__button lightbox__button--next" type="button" data-lightbox-next>
    <Icon name="chevron" />
  </button>
  <div class="lightbox__dots" aria-hidden="true">
    {photos.map(() => <span class="lightbox__dot" data-lightbox-dot />)}
  </div>
</dialog>
