---
import './Icon.css';

// Свои тонкие контурные значки. Стрелка и звезда — SVG, а не символы → и ★:
// этих символов нет в латинском наборе шрифтов, текстом они притянули бы лишние файлы.
export type IconName = 'whatsapp' | 'phone' | 'arrow' | 'chevron' | 'star' | 'close' | 'menu';

interface Props {
  name: IconName;
}

const PATHS: Record<IconName, string> = {
  whatsapp:
    'M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z',
  phone:
    'M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z',
  arrow: 'M4 12h16m-6-6 6 6-6 6',
  chevron: 'm6 9 6 6 6-6',
  star: 'm12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3l-5.6 2.9 1.1-6.2L3 9.6l6.2-.9z',
  close: 'M5 5l14 14M19 5 5 19',
  menu: 'M4 8h16M4 16h16',
};

const FILLED_ICONS: IconName[] = ['star'];

const { name } = Astro.props;
const isFilled = FILLED_ICONS.includes(name);
---

<svg class:list={['icon', { 'icon--filled': isFilled }]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path d={PATHS[name]}></path>
</svg>
