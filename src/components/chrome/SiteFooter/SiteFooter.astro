---
import OpeningHours from '@/components/ui/OpeningHours/OpeningHours.astro';
import RestaurantName from '@/components/ui/RestaurantName/RestaurantName.astro';
import { EXTERNAL_LINK } from '@/config/links';
import { FACEBOOK_URL, INSTAGRAM_URL, MAPS_URL, PHONE_HREF } from '@/config/restaurant';
import type { Dictionary } from '@/i18n';
import shared from '@/i18n/shared.json';
import './SiteFooter.css';

// Подвал: название, строка о ресторане, адрес, часы, телефон и соцсети — всё из существующих текстов.
interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const { reservations } = t;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__name"><RestaurantName /></p>
      <p class="label site-footer__tagline">{t.footer.tagline}</p>
    </div>
    <div class="site-footer__block">
      <p class="label">{reservations.addressLabel}</p>
      <a class="site-footer__link" href={MAPS_URL} data-goal="address-footer" {...EXTERNAL_LINK}>{reservations.address}</a>
    </div>
    <div class="site-footer__block">
      <p class="label">{reservations.hoursLabel}</p>
      <OpeningHours t={t} />
    </div>
    <ul class="site-footer__block site-footer__contacts">
      <li><a class="site-footer__link" href={PHONE_HREF} data-goal="call-footer">{reservations.call}</a></li>
      <li>
        <a class="site-footer__link" href={INSTAGRAM_URL} data-goal="instagram-footer" {...EXTERNAL_LINK}>
          {shared.social.instagram}
        </a>
      </li>
      <li>
        <a class="site-footer__link" href={FACEBOOK_URL} data-goal="facebook-footer" {...EXTERNAL_LINK}>
          {shared.social.facebook}
        </a>
      </li>
    </ul>
  </div>
</footer>
